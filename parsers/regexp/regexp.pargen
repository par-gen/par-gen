#######################################
#
# Tokens
#
CHARACTER := '[^\(\)\[\]\|\.\*?+\r\n\b\t\f\\]' @ initial;
CHARACTER := '[^\[\]\r\n\b\t\f\\\-\^]' @ character-class;
HEX_PREFIX := '\\x' @ initial, character-class;
HEX_NUMBER := '[0-9a-f]' @ hex-escape;
ESCAPED_CHARACTER := '\\[\(\)\[\]\|\.\*?+rnbtf\\\-\^]' @ initial, character-class;
CARET := '^' @ character-class;
DASH := '-' @ character-class;
DOT := '\.' @ initial;
UNION := '\|' @ initial;
PAREN_OPEN := '\(' @ initial;
PAREN_CLOSE := '\)' @ initial;
QUANTIFIER := '[\*?+]' @ initial;
BRACKET_OPEN := '\[' @ initial;
BRACKET_CLOSE := '\]' @ character-class;

#######################################
#
# Rules
#

RegExp := Expression;

Expression := Union | Sequence | Atom;

Union :=
  | Union UNION Sequence
  | Union UNION Atom
  | Union UNION
  | Sequence UNION Sequence
  | Sequence UNION Atom
  | Sequence UNION
  | Atom UNION Sequence
  | Atom UNION Atom
  | Atom UNION
  ;

Sequence :=
    Atom Atom
  | Sequence Atom
  ;

Atom :=
    Character
  | Character QUANTIFIER
  | DOT
  | DOT QUANTIFIER
  | Group
  | Group QUANTIFIER
  | CharacterClass
  | CharacterClass QUANTIFIER
  ;

Group :=
    PAREN_OPEN Union PAREN_CLOSE
  | PAREN_OPEN Sequence PAREN_CLOSE
  | PAREN_OPEN Atom PAREN_CLOSE
  ;

CharacterClass :=
    { lexer.push('character-class') } BRACKET_OPEN CharacterClassCharacters { lexer.pop() } BRACKET_CLOSE
  | { lexer.push('character-class') } BRACKET_OPEN CARET CharacterClassCharacters { lexer.pop() } BRACKET_CLOSE
  ;

CharacterClassCharacters :=
    CharacterClassCharacter
  | CharacterClassCharacters CharacterClassCharacter
  ;

CharacterClassCharacter :=
    CHARACTER
  | ESCAPED_CHARACTER
  | HexEscape
  | CharacterClassRange
  ;

CharacterClassRange :=
    CHARACTER DASH CHARACTER
  | HexEscape DASH HexEscape
  | HexEscape DASH CHARACTER
  | CHARACTER DASH HexEscape
  ;

Character :=
    CHARACTER
  | ESCAPED_CHARACTER
  | HexEscape
  ;

HexEscape :=
    { lexer.push('hex-escape') } HEX_PREFIX HEX_NUMBER { lexer.pop() } HEX_NUMBER
  ;
